{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=investor_data.db"
  },
  "CrawlOptions": {
    "MaxPagesPerCompany": 50,
    "MaxCrawlDepth": 4,
    "RequestTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "RetryBaseDelayMilliseconds": 1000,
    "MaxConcurrentCompanies": 5,
    "WebsiteConfidenceThreshold": 0.70,
    "EnablePlaywrightFallback": true,
    "MaxDynamicPagesToRender": 5,
    "MaxConcurrentBrowsers": 2,
    "DownloadTimeoutSeconds": 300,
    "EnableCrawlAudit": false,
    "StorageDirectory": "InvestorData",
    "DatabaseProvider": "Sqlite",
    "ConnectionString": "Data Source=investor_data.db",
    "TargetDocumentScoreThreshold": 70,
    "TargetDocumentPossibleCandidateMinScore": 40
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
