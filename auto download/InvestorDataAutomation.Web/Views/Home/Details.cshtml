@model InvestorDataAutomation.Core.DTOs.CompanyDetailDto
@{
    ViewData["Title"] = $"{Model.CompanyName} - Company Details";
}

<div class="mb-4">
    <a href="/Home/Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
    
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold mb-1">
                @Model.CompanyName
                @if (!string.IsNullOrEmpty(Model.NSESymbol))
                {
                    <span class="badge bg-light text-dark border fs-6 ms-2">NSE: @Model.NSESymbol</span>
                }
                @if (!string.IsNullOrEmpty(Model.BSECode))
                {
                    <span class="badge bg-light text-dark border fs-6 ms-1">BSE: @Model.BSECode</span>
                }
            </h2>
            <p class="text-muted mb-0">
                Official Website: 
                @if (!string.IsNullOrEmpty(Model.Website))
                {
                    <a href="@Model.Website" target="_blank" class="fw-semibold">@Model.Website</a>
                    <span class="ms-2 text-muted">(Confidence: @Model.WebsiteConfidence.ToString("P0"))</span>
                }
                else
                {
                    <span class="text-danger">Not Discovered</span>
                }
            </p>
        </div>
        <div>
            <span class="fs-6 px-3 py-2 badge bg-@(Model.Status == "Completed" ? "success" : Model.Status == "Processing" ? "info" : Model.Status == "NeedsReview" ? "warning" : "danger")">
                Status: @Model.Status
            </span>
        </div>
    </div>
</div>

<!-- Key Info Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3 bg-white border-0">
            <div class="text-muted small fw-semibold">Investor Page</div>
            <div class="fw-bold text-truncate mt-1">
                @if (!string.IsNullOrEmpty(Model.InvestorPage))
                {
                    <a href="@Model.InvestorPage" target="_blank">@Model.InvestorPage</a>
                }
                else
                {
                    <span class="text-muted">N/A</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 bg-white border-0">
            <div class="text-muted small fw-semibold">Pages Scanned</div>
            <div class="fs-4 fw-bold mt-1">@Model.PagesScanned</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 bg-white border-0">
            <div class="text-muted small fw-semibold">Documents Found</div>
            <div class="fs-4 fw-bold text-primary mt-1">@Model.DocumentsFound</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 bg-white border-0">
            <div class="text-muted small fw-semibold">Documents Downloaded</div>
            <div class="fs-4 fw-bold text-success mt-1">@Model.DocumentsDownloaded</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.FailureReason))
{
    <div class="alert alert-warning mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>Processing Note / Exception:</strong> @Model.FailureReason
    </div>
}

<!-- Documents List -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0"><i class="bi bi-file-earmark-pdf text-danger me-2"></i>Discovered Investor Documents</h5>
        <span class="badge bg-primary">@Model.Documents.Count Total</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Document Title</th>
                        <th>Type</th>
                        <th>Period</th>
                        <th>Format</th>
                        <th>Size</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Documents.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No documents discovered yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var doc in Model.Documents)
                        {
                            var periodStr = !string.IsNullOrEmpty(doc.Quarter) ? $"{doc.Quarter} {doc.FinancialYear}" : doc.FinancialYear ?? doc.DocumentDate ?? "-";
                            <tr>
                                <td>
                                    <div class="fw-semibold text-truncate" style="max-width: 350px;" title="@doc.DocumentTitle">
                                        @doc.DocumentTitle
                                    </div>
                                    <a href="@doc.DocumentUrl" target="_blank" class="small text-muted text-truncate d-block" style="max-width: 350px;">
                                        @doc.DocumentUrl
                                    </a>
                                </td>
                                <td><span class="badge bg-secondary">@doc.DocumentType</span></td>
                                <td><span class="fw-semibold">@periodStr</span></td>
                                <td><code>@(doc.FileExtension?.ToUpper() ?? ".PDF")</code></td>
                                <td>@(doc.FileSize > 0 ? $"{(doc.FileSize / 1024.0):N0} KB" : "-")</td>
                                <td>
                                    @if (doc.Status == "Downloaded")
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i> Downloaded</span>
                                    }
                                    else if (doc.Status == "SkippedDuplicate")
                                    {
                                        <span class="badge bg-info"><i class="bi bi-intersect me-1"></i> Duplicate</span>
                                    }
                                    else if (doc.Status == "Failed")
                                    {
                                        <span class="badge bg-danger" title="@doc.ErrorMessage"><i class="bi bi-x-lg me-1"></i> Failed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">@doc.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (doc.DownloadUrl != null)
                                    {
                                        <a href="@doc.DownloadUrl" class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-download me-1"></i> Download File
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@doc.DocumentUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-box-arrow-up-right me-1"></i> Open URL
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Crawl Logs -->
<div class="card shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-journal-text me-2"></i>Crawl Activity Log</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Stage</th>
                        <th>Target URL</th>
                        <th>Pages</th>
                        <th>Docs</th>
                        <th>Status</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td><code>@log.Stage</code></td>
                            <td class="text-truncate" style="max-width: 300px;">@log.Url</td>
                            <td>@log.PagesScanned</td>
                            <td>@log.DocumentsFound</td>
                            <td><span class="badge bg-@(log.Status == "Success" ? "success" : "secondary")">@log.Status</span></td>
                            <td><small class="text-muted">@log.StartedAt</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
